# Author: Zeday | https://join.co.id
# Salin file ini menjadi .env dan isi sesuai kebutuhan.

NEXT_PUBLIC_SITE_URL=https://sd.join.co.id
NEXT_PUBLIC_SITE_NAME="SD Inovasi Ceria"

# SMTP untuk form kontak & pendaftaran (opsional, isi untuk mengaktifkan email konfirmasi)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SD Inovasi Ceria <no-reply@sd.join.co.id>"
CONTACT_RECEIVER_EMAIL=info@sdceria.sch.id

# Google Analytics (opsional)
NEXT_PUBLIC_GA_ID=

# Google Maps embed (opsional, ganti dengan src iframe sekolah anda)
NEXT_PUBLIC_MAPS_EMBED_SRC=

# WAJIB diisi sebelum deploy. Dipakai SATU KALI saat server pertama kali
# jalan untuk membuat akun admin pertama (username "admin", peran "owner"),
# lalu tetap dipakai sebagai kunci penandatanganan sesi login - bukan lagi
# password yang dicek langsung setiap login (itu sekarang per-akun, lihat
# menu Pengguna di /admin). Tetap wajib diisi dengan nilai acak yang kuat.
ADMIN_PASSWORD=

# Kredit "Dikembangkan oleh Zeday" di footer. Set "false" untuk paket
# klien yang membeli tanpa kredit developer. Kosongkan/hapus baris ini
# (atau isi selain "false") untuk tetap menampilkannya.
NEXT_PUBLIC_SHOW_DEVELOPER_CREDIT=true
